  {
    "id": "post-1794564064562-5c2t",
    "type": "quotes",
    "title": "дебинская тупость",
    "text": "Зачем?",
    "author": "Miralys",
    "createdAt": "2026-11-13T10:01:04.562Z",
    "tags": [
